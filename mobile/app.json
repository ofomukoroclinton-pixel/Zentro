{
  "expo": {
    "name": "Zentro",
    "slug": "zentro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "zentro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zentro.app",
      "associatedDomains": [
        "applinks:zentro.app"
      ]
    },
    "android": {
      "package": "com.zentro.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "zentro.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
  "expo-router",
  "expo-notifications",
  "expo-image-picker"
    ],
    "extra": {
  "eas": {
    "projectId": "3ff08d04-0edd-4ae3-baf6-f1864361c750"
  }
    }
  }
}
